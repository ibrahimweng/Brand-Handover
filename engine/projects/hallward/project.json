{
  "brand": "Hallward Press",
  "version": "1.0.0",
  "assets": { "mark": "mark.svg", "wordmark": "wordmark.svg" },
  "tokens": {
    "colour": {
      "ink":   { "hex": "#14110E", "role": "primary", "pantone": "Black 4 C", "cmyk": [60, 55, 60, 90] },
      "paper": { "hex": "#FBFAF7", "role": "ground",  "pantone": "11-0601",   "cmyk": [1, 1, 3, 0] }
    },
    "type": {
      "families": {
        "display": { "family": "Literata", "fallback": "Georgia, 'Times New Roman', serif", "weights": [400, 600, 700], "google": true }
      },
      "scale": [
        { "name": "Display", "family": "display", "size": 64, "leading": 70, "weight": 700, "tracking": -0.015 },
        { "name": "H1",      "family": "display", "size": 36, "leading": 44, "weight": 700 },
        { "name": "H2",      "family": "display", "size": 24, "leading": 32, "weight": 600 },
        { "name": "H3",      "family": "display", "size": 18, "leading": 26, "weight": 600 },
        { "name": "Body",    "family": "display", "size": 16, "leading": 27, "weight": 400 },
        { "name": "Small",   "family": "display", "size": 13, "leading": 21, "weight": 400 },
        { "name": "Caption", "family": "display", "size": 11, "leading": 16, "weight": 400, "tracking": 0.06 }
      ]
    }
  },
  "rules": {
    "clearSpaceRatio": 0.25,
    "minStrokePx": 3,
    "minStrokeMm": 0.8,
    "lockupGapRatio": 0.3,
    "wordmarkHeightRatio": 0.34,
    "naming": "{brand}-{lockup}",
    "lockups": ["horizontal", "stacked", "mark"],
    "formats": ["svg", "png", "pdf"],
    "pngWidths": [800],
    "stock": "coated",
    "colourways": [
      { "name": "ink", "on": "paper", "slots": { "seal": "#14110E" } }
    ],
    "iconInk": "#FBFAF7",
    "iconBg": "#14110E",
    "iconSizes": [1024, 180],
    "faviconSizes": [16, 32]
  },
  "content": {
    "positioning": "Hallward Press",
    "misuse": ["Do not stretch it", "Do not rotate it", "Do not tint it", "Do not add a shadow", "Do not crowd it", "Do not redraw the seal"]
  }
}
