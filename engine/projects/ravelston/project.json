  "content": {
    "positioning": "Ravelston has been distilling above the same spring since 1843, and the crest was cut for the gate that year.",
    "introduction": "A working distillery with a heraldic crest it did not commission and cannot replace. The mark is an engraving: a hatched shield, a chevron, and three casks. It was drawn to be cut into stone at half a metre across.",
    "markRationale": "Heraldic hatching reads as a colour to anybody who knows the convention and as texture to everybody else. The chevron carries the eye to the casks. None of it was designed for a screen and all of it has to work on one.",
    "colourRationale": "Oak is the ink and Linen is the paper. Copper is for the still house and the cask ends. Seal is for the wax and appears once on anything.",
    "typeRationale": "A serif with enough weight to sit beside an engraving without looking apologetic, and a plain sans for everything a customer actually has to read.",
    "misuse": [
      { "do": "undersize", "why": "The hatching closes and the crest becomes a dark shape. Use the simplified mark in 05-icons." },
      { "do": "stretch", "why": "Scale both axes together, always." },
      { "do": "recolour" },
      { "do": "shadow", "why": "It is engraved already." },
      { "do": "busy", "why": "Use the reversed lockup." }
    ],
    "constructionNotes": "The shield is 228 wide inside a 240 box, tapering below 58 percent of its height. The hatch is five units of ink to one and a fifth of paper, which is the pitch the original was cut at."
  }
