{
  "brand": "Ancroft",
  "version": "1.0.0",
  "assets": {
    "mark": "mark.svg",
    "wordmark": "wordmark.svg",
    "tiers": [
      { "name": "standard", "file": "mark-standard.svg", "note": "The hatching goes. Nothing under eight units." },
      { "name": "compact", "file": "mark-compact.svg", "note": "The shield and the chevron, at one unit." },
      { "name": "monogram", "file": "mark-monogram.svg", "note": "The shield solid, the chevron cut out of it." }
    ]
  },
  "tokens": {
    "colour": {
      "holly":  { "hex": "#123B2E", "role": "primary",   "cmyk": [88, 47, 78, 55], "pantone": "3435 C" },
      "chalk":  { "hex": "#F5F3EC", "role": "ground",    "cmyk": [4, 3, 8, 0],     "pantone": "11-0601" },
      "brass":  { "hex": "#B08D3F", "role": "accent",    "cmyk": [28, 42, 88, 8],  "pantone": "465 C" },
      "slate":  { "hex": "#5A6068", "role": "neutral",   "cmyk": [62, 48, 42, 12], "pantone": "431 C" },
      "cherry": { "hex": "#8E2C33", "role": "secondary", "cmyk": [28, 92, 78, 22], "pantone": "1815 C" }
    },
    "type": {
      "families": {
        "display": { "family": "Fraunces", "google": true, "weights": [500, 700], "fallback": "Georgia,serif" },
        "text":    { "family": "Public Sans", "google": true, "weights": [400, 600], "fallback": "Helvetica,Arial,sans-serif" }
      },
      "scale": [
        { "name": "Display", "family": "display", "size": 48, "leading": 54, "weight": 700, "sample": "Founded 1614" },
        { "name": "H1", "family": "display", "size": 32, "leading": 38, "weight": 700, "sample": "Admissions" },
        { "name": "H2", "family": "display", "size": 23, "leading": 29, "weight": 500, "sample": "The Michaelmas term" },
        { "name": "H3", "family": "text", "size": 18, "leading": 24, "weight": 600, "sample": "Open mornings" },
        { "name": "Body", "family": "text", "size": 17, "leading": 27, "weight": 400, "sample": "The arms were granted in 1614 and have been cut in stone over the gate ever since." },
        { "name": "Small", "family": "text", "size": 14, "leading": 21, "weight": 400, "sample": "Registered charity 306281." },
        { "name": "Caption", "family": "text", "size": 12, "leading": 17, "weight": 600, "tracking": 0.08, "sample": "ANCROFT SCHOOL" }
      ]
    }
  },
  "rules": {
    "lockups": ["horizontal", "stacked", "mark", "wordmark"],
    "ladder": ["horizontal", "mark", "standard", "compact", "monogram"],
    "colourways": [
      { "name": "holly",   "on": "chalk", "slots": { "ink": "#123B2E" } },
      { "name": "reverse", "on": "holly", "slots": { "ink": "#F5F3EC" } },
      { "name": "brass",   "on": "holly", "slots": { "ink": "#B08D3F" } },
      { "name": "mono",    "on": "chalk", "slots": { "ink": "#000000" } }
    ],
    "fabrication": [
      { "process": "embroidery", "at": 70,  "note": "the blazer badge" },
      { "process": "embroidery", "at": 32,  "note": "the cap badge" },
      { "process": "embroidery", "at": 18,  "note": "the house tie" },
      { "process": "engraving",  "at": 240, "tool": 3, "note": "the stone over the gate" },
      { "process": "vinyl",      "at": 400, "note": "the minibus door" },
      { "process": "screenprint","at": 120, "note": "the games kit" },
      { "process": "foil",       "at": 22,  "note": "the bookplate" },
      { "process": "cast",       "at": 90,  "note": "the bench plaque" }
    ],
    "clearSpaceRatio": 0.22,
    "formats": ["svg", "png"],
    "pngWidths": [512, 1024],
    "naming": "{brand}-{lockup}-{colourway}"
  },
  "system": {
    "grid": { "unit": 12, "box": 240, "note": "Twenty units square. The shield is twelve units across the chief and the chevron rises three." }
  },
  "content": {
    "positioning": "Ancroft has been cutting the same arms into things since 1614.",
    "markRationale": "The arms as granted: a chevron between three roundels, over a band of hatching that stands for the ford.",
    "constructionNotes": "Twenty units square. Every point is on the module; the hatching is three units wide, which is the finest thing in the identity and the reason the other three drawings exist."
  }
}
