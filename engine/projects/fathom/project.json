{
  "brand": "Fathom",
  "version": "2.0.0",
  "assets": { "mark": "mark.svg", "wordmark": "wordmark.svg" },
  "tokens": {
    "colour": {
      "deep":  { "hex": "#0F3A46", "role": "ground",    "pantone": "3025 C", "cmyk": [92, 62, 45, 30] },
      "foam":  { "hex": "#F1F0EA", "role": "primary",   "pantone": "11-0601", "cmyk": [4, 3, 7, 0] },
      "ember": { "hex": "#C56A2E", "role": "accent",    "pantone": "1525 C", "cmyk": [18, 68, 96, 5] },
      "kelp":  { "hex": "#4A6B5C", "role": "secondary", "pantone": "5545 C", "cmyk": [70, 40, 60, 20] },
      "haar":  { "hex": "#8E9A9E", "role": "neutral",   "pantone": "429 C",  "cmyk": [44, 30, 28, 2] }
    },
    "type": {
      "families": {
        "display": { "family": "Archivo", "fallback": "Helvetica, Arial, sans-serif", "weights": [600, 700], "google": true },
        "text":    { "family": "Literata", "fallback": "Georgia, serif", "weights": [400, 500], "google": true }
      },
      "scale": [
        { "name": "Display", "family": "display", "size": 68, "leading": 74, "weight": 700 },
        { "name": "H1",      "family": "display", "size": 38, "leading": 45, "weight": 700 },
        { "name": "H2",      "family": "display", "size": 25, "leading": 32, "weight": 600 },
        { "name": "H3",      "family": "display", "size": 18, "leading": 26, "weight": 600 },
        { "name": "Body",    "family": "text",    "size": 16, "leading": 27, "weight": 400 },
        { "name": "Small",   "family": "text",    "size": 13, "leading": 21, "weight": 400 },
        { "name": "Caption", "family": "display", "size": 11, "leading": 16, "weight": 600 }
      ]
    }
  },
  "rules": {
    "clearSpaceRatio": 0.3, "minStrokePx": 3, "minStrokeMm": 0.8,
    "lockupGapRatio": 0.26, "wordmarkHeightRatio": 0.46,
    "naming": "{brand}-{lockup}-{colourway}",
    "lockups": ["horizontal", "stacked", "mark"],
    "formats": ["svg", "png", "pdf"],
    "pngWidths": [512, 1600],
    "stock": "coated",
    "colourways": [
      { "name": "full",    "on": "foam", "slots": { "ink": "#0F3A46", "tide": "#C56A2E" } },
      { "name": "reverse", "on": "deep", "slots": { "ink": "#F1F0EA", "tide": "#C56A2E" } },
      { "name": "flat",    "on": "foam", "slots": { "ink": "#0F3A46", "tide": "#0F3A46" } }
    ],
    "iconInk": "#F1F0EA", "iconBg": "#0F3A46",
    "iconSizes": [1024, 180], "faviconSizes": [16, 32],
    "social": { "profile": { "w": 400, "h": 400 }, "og image": { "w": 1200, "h": 630 } }
  },
  "content": {
    "positioning": "Fathom",
    "misuse": ["Do not stretch it", "Do not rotate it", "Do not recolour the tide", "Do not add a shadow", "Do not crowd it", "Do not outline it"]
  },
  "system": {
    "pattern": { "tile": 96, "rowSpacing": 0.26, "phase": 0.5, "weight": 5, "cap": "round",
                 "densities": { "fine": 0.5, "medium": 1, "coarse": 2 } }
  }
}
